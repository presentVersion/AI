  --game-color: #E52592;
  --classroom-color: #01877E;
  --external-course-color: #D56E0C;
  --certification-color: #C5221F;
}

abbr[title],
abbr[data-original-title] {
  border-bottom: none !important;
}

label abbr[title] {
  color: var(--primary-text-on-surface-color);
}

hr {
  border: 0;
  border-top: 1px solid var(--hairline-color);
  display: block;
  height: 1px;
  margin: 24px 0;
  padding: 0;
}

mark {
  background-color: #F9AB00;
  border-radius: 2px;
  color: inherit;
  padding: 2px 0px;
}

p, li {
  font: var(--md-sys-typescale-body-large);
}

._small-label_rop5s_37,
._label--small_rop5s_38 {
  font: var(--md-sys-typescale-body-medium);
  text-decoration: none;
}

strong {
  font-weight: 700;
}

._mdl-typography--small-title_rop5s_47 {
  color: #202124;
  font-size: 15px;
  font-weight: 400;
}

._text--blue_rop5s_53 {
  color: var(--primary-text-on-surface-color);
}

._text--center_rop5s_57 {
  text-align: center;
}

._text--capitalize_rop5s_61 {
  text-transform: capitalize;
}

._text--code_rop5s_65 {
  font-family: "Roboto Mono", monospace;
}

._text--copy_rop5s_69 {
  font-family: var(--md-ref-typeface-plain);
}

._text--error_rop5s_73 {
  color: var(--warn-color);
}

._text--free_rop5s_77 {
  color: var(--success-color);
  font-weight: 700;
  text-transform: uppercase;
}

._text--gray_rop5s_83 {
  color: rgba(0, 0, 0, 0.54);
}

._text--light_rop5s_87 {
  color: var(--light-text-on-surface-color) !important;
}

._text--right_rop5s_91 {
  text-align: right;
}

._text--sign_rop5s_95 {
  font-family: "Oswald", sans-serif;
}

._text--small_rop5s_99 {
  font-size: 14px !important;
}

._text--large_rop5s_103 {
  font-size: 20px !important;
}

._text--success_rop5s_107 {
  color: var(--success-color) !important;
}

._text--yellow_rop5s_111 {
  color: #F9AB00;
}

._text--red_rop5s_115 {
  color: #D93025;
}

._text--green_rop5s_119 {
  color: #34A853;
}

u {
  text-decoration: none;
}

._material-icons_rop5s_127 {
  font-family: "Material Icons";
  font-weight: normal;
  font-style: normal;
  font-size: 24px; /* Preferred icon size */
  display: inline-block;
  line-height: 1;
  text-transform: none;
  letter-spacing: normal;
  word-wrap: normal;
  white-space: nowrap;
  direction: ltr;
  /* Support for all WebKit browsers. */
  -webkit-font-smoothing: antialiased;
  /* Support for Safari and Chrome. */
  text-rendering: optimizeLegibility;
  /* Support for Firefox. */
  -moz-osx-font-smoothing: grayscale;
  /* Support for IE. */
  font-feature-settings: "liga";
}

._ellipsis_rop5s_149 {
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
}

._text--rtl_rop5s_155 {
  direction: rtl;
}

._body-wrapper_rop5s_159 {
  max-width: 800px;
}

._text--button_rop5s_163 {
  font: var(--md-sys-typescale-label-large);
}

._text--nowrap_rop5s_167 {
  white-space: nowrap;
}

._video-button-outline_rop5s_171 {
  --md-focus-ring-color: transparent;
  position: relative;
}
._video-button-outline_rop5s_171:focus-within::after {
  border: 3px solid var(--md-sys-color-secondary);
  border-radius: calc(var(--icon-size) * 0.18);
  content: "";
  height: calc(var(--icon-size) * 0.59);
  left: 50%;
  pointer-events: none;
  position: absolute;
  top: 50%;
